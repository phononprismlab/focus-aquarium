NODE_ENV=development
# 本地开发用哪个端口都行。容器/生产默认 8080（非特权端口）——
# 容器以非 root 运行，绑 80 会被部分容器运行时拒绝，且失败时表现为
# "日志说 listening、平台探针 connection refused"。改了必须同步改云托管控制台的「服务端口」。
PORT=8787
# 额外监听的端口，逗号分隔。默认 80 —— 兼容云托管控制台「服务端口」被固定成 80 的情况，
# 应用同时听 PORT 和 80，平台探针打哪个都能通。某个端口绑不上只会记日志、不会让进程退出，
# 只有全部端口都失败才退出。端口配置确定后设成空串即可关掉：EXTRA_PORTS=
EXTRA_PORTS=
CLOUDBASE_ENV_ID=
CLOUDBASE_COLLECTION=fishtank_configs
# 允许跨域访问的前端来源，逗号分隔。三种写法：
#   https://app.example.com   精确匹配一个来源
#   *.tcloudbaseapp.com       通配子域（云托管 / 静态托管分配的随机子域）
#   null                      允许本地 file:// 直接打开的页面
#   *                        放行所有来源，仅在明确接受该风险时使用
# 留空会回落到内置兜底名单（含测试域名），生产环境请务必显式配置。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 管理接口（/api/admin/*）的密钥，请求时放在 x-admin-key 头里。
# 留空 = 管理接口无需凭据，仅限本地开发。
# NODE_ENV=production 时必须配置，否则服务会拒绝启动（避免生产环境管理接口裸奔）。
# 建议至少 16 位随机字符，过短会打印警告。
ADMIN_API_KEY=
STORAGE_DRIVER=cloudbase
MAX_UPLOAD_MB=15
UPLOAD_DIR=
CLOUDBASE_APIKEY=
# ---- 云存储形态（选错会导致上传必然失败，且报错与权限无关）----
# 传统模式：getUploadMetadata 拿签名后直传 COS。控制台看到的是「权限模式 / JSON 安全规则」。
# PG 模式 ：统一经由 Storage API 网关，由它在事务里写 storage.objects。控制台能看到
#            storage.objects / storage.buckets 两张表上的 RLS 策略。
# 默认 pg（本项目环境就是 PG 模式）；传统形态的环境请显式设成 classic。
CLOUDBASE_STORAGE_MODE=pg
# PG 模式下的桶名（对应 storage.buckets.id）。
CLOUDBASE_BUCKET=aquarium-assets
# 调用网关用的 Bearer token，默认取 CLOUDBASE_APIKEY（需为 service_role 角色的密钥）。
CLOUDBASE_STORAGE_TOKEN=
# 用 SecretId/SecretKey 直连 COS（传统模式）。两个都填才生效，否则走 CLOUDBASE_APIKEY。
CLOUDBASE_SECRETID=
CLOUDBASE_SECRETKEY=
# 签名 URL 的有效期（秒），下限 600。默认 86400（1 天）—— 玩家端缓存素材链接用这个时长。
CLOUDBASE_SIGN_TTL_SECONDS=86400
# 批量解析素材链接的并发数。调大更快，但容易触发上游限流。默认 6。
CLOUDBASE_RESOLVE_CONCURRENCY=6

# ---- 图片下发（玩家端看到的素材）----
# 1（默认）时给图片挂 imageMogr2 转 WebP + quality 80，体积能小一半以上；
# SVG/GIF 不转（转了会丢透明/动画）。设 0 关闭，直接下发原图。
FISHTANK_IMAGE_WEBP=1

# ---- 上传压缩（Tinify）----
# 后台传图时先压一道再入库。**留空 = 不做压缩，原图直通**（不报错、不影响上传）。
# 取值：https://tinify.com/dashboard 上的 API key。
TINIFY_API_KEY=
# 设 0 关闭压缩（保留代码路径，方便对比压缩前后的画质）。默认开。
FISHTANK_TINIFY=1
# 单张图压缩的超时（毫秒），下限 1000。超时按「没压成」处理，原图照常上传。默认 15000。
TINIFY_TIMEOUT_MS=15000

# ---- 其他运行时开关 ----
# 监听地址。默认 0.0.0.0（容器必须这样，否则平台探针连不上）。
HOST=0.0.0.0
# JSON 请求体上限（Express body-parser 语法）。默认 2mb。
JSON_BODY_LIMIT=2mb
# 云存储上传失败时是否回落到容器本地磁盘。非 production 环境**默认就允许**，
# 这个开关是给生产显式打开的：生产回落 = 把 /uploads/xxx 这种只在这台实例活着时有效的地址
# 写进配置，实例一重建就全 404，而且失败被吞掉、后台还以为存成功了。生产保持留空。
ALLOW_LOCAL_FALLBACK=
# 建号票据（一次性登录码）的有效期（秒）。默认 3600。
ACCOUNT_TICKET_TTL_SECONDS=3600
# 建号票据接口的每分钟上限（同一来源）。默认 300。
ACCOUNT_TICKET_RATE_LIMIT=300
# 新账号的 cohort。默认 early（灰度期）；公开发布时设 public。
FISHTANK_COHORT=
# 诊断模式：设 1 会额外打印数据层/存储层的解析过程。排障用，平时留空。
FISHTANK_DIAG=
# 紧急总开关：设 1 后公开接口不再下发鱼的动画代码（玩家端回退到内置行为）。
# 线上自定义动画代码出问题时的「一键刹车」，平时留空。
FISHTANK_DISABLE_CUSTOM_CODE=
