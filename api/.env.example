NODE_ENV=development
# 本地开发用哪个端口都行。容器/生产默认 8080（非特权端口）——
# 容器以非 root 运行，绑 80 会被部分容器运行时拒绝，且失败时表现为
# "日志说 listening、平台探针 connection refused"。改了必须同步改云托管控制台的「服务端口」。
PORT=8787
# 额外监听的端口，逗号分隔。默认 80 —— 兼容云托管控制台「服务端口」被固定成 80 的情况，
# 应用同时听 PORT 和 80，平台探针打哪个都能通。某个端口绑不上只会记日志、不会让进程退出，
# 只有全部端口都失败才退出。端口配置确定后设成空串即可关掉：EXTRA_PORTS=
EXTRA_PORTS=
CLOUDBASE_ENV_ID=
CLOUDBASE_COLLECTION=fishtank_configs
# 允许跨域访问的前端来源，逗号分隔。三种写法：
#   https://app.example.com   精确匹配一个来源
#   *.tcloudbaseapp.com       通配子域（云托管 / 静态托管分配的随机子域）
#   null                      允许本地 file:// 直接打开的页面
#   *                        放行所有来源，仅在明确接受该风险时使用
# 留空会回落到内置兜底名单（含测试域名），生产环境请务必显式配置。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 管理接口（/api/admin/*）的密钥，请求时放在 x-admin-key 头里。
# 留空 = 管理接口无需凭据，仅限本地开发。
# NODE_ENV=production 时必须配置，否则服务会拒绝启动（避免生产环境管理接口裸奔）。
# 建议至少 16 位随机字符，过短会打印警告。
ADMIN_API_KEY=
STORAGE_DRIVER=cloudbase
MAX_UPLOAD_MB=15
UPLOAD_DIR=
CLOUDBASE_APIKEY=
# ---- 云存储形态（选错会导致上传必然失败，且报错与权限无关）----
# 传统模式：getUploadMetadata 拿签名后直传 COS。控制台看到的是「权限模式 / JSON 安全规则」。
# PG 模式 ：统一经由 Storage API 网关，由它在事务里写 storage.objects。控制台能看到
#            storage.objects / storage.buckets 两张表上的 RLS 策略。
# 默认 pg（本项目环境就是 PG 模式）；传统形态的环境请显式设成 classic。
CLOUDBASE_STORAGE_MODE=pg
# PG 模式下的桶名（对应 storage.buckets.id）。
CLOUDBASE_BUCKET=aquarium-assets
# 调用网关用的 Bearer token，默认取 CLOUDBASE_APIKEY（需为 service_role 角色的密钥）。
CLOUDBASE_STORAGE_TOKEN=
